#version 450
// Synthesizes a premultiplied UI color+alpha layer from the presented backbuffer (B) and the
// captured HUD-less frame (C) of the same epoch. The composition contract (Intel XeSS-FG guide)
//   FinalColor.RGB = UI.RGB + (1 - UI.A) * HUDlessColor.RGB
// holds by construction for any estimated alpha: UI = B - (1-a)*C reproduces B exactly.
// The alpha estimate is the v4.6 two-sided unmix below; mode 5's extraction refinement only
// ever layers the SDK's own (equally noisy) estimate on top, so quality lives here.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform sampler2D presentedColor;
layout(set = 0, binding = 1) uniform sampler2D hudlessColor;
layout(set = 0, binding = 2, rgba8) uniform writeonly image2D uiColor;
layout(push_constant) uniform Params { uint width; uint height; uint swizzleBGRA; uint debugTint; } params;

// v4.6 alpha estimator (offline-validated in tools/sim-ui-estimator.py, replacing max-delta*2):
// two-sided coverage unmix of B = a*U + (1-a)*C. White-UI model (U saturated): a = (B-C)/(1-C);
// dark-UI model (U near black): a = (C-B)/C. Per-pixel max of both, after a 0.012 (~1 sigma of
// tone-map grain) deadband that suppresses background leak/flicker, with 0.15 denominator floors
// where the unmix is ill-conditioned (white UI on white sky, dark UI on black world). Simulation
// vs ground truth (wheel+minimap+panel+dark block, per-pixel independent capture noise):
//   UI coverage MAE 0.56 -> 0.19 (dark UI coverage was simply missed by max-delta),
//   background leak 0.0135 -> 0.0096, EMA'd UI flicker 0.0133 -> 0.0105, opaque-center bias halved
//   (center a=1 means the generated frame reproduces B exactly and CANNOT flicker).
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(params.width) || p.y >= int(params.height)) return;
    vec3 B = texelFetch(presentedColor, p, 0).rgb;
    vec3 C = texelFetch(hudlessColor, p, 0).rgb;
    float cmax = max(C.r, max(C.g, C.b));
    float dup = max(B.r - C.r, max(B.g - C.g, B.b - C.b)) - 0.012;
    float ddn = max(C.r - B.r, max(C.g - B.g, C.b - B.b)) - 0.012;
    float a = 0.0;
    if (dup > 0.0) a = dup / max(1.0 - cmax, 0.15);
    if (ddn > 0.0) a = max(a, ddn / max(cmax, 0.15));
    a = clamp(a, 0.0, 1.0);
    if (a <= 0.0) { imageStore(uiColor, p, vec4(0.0)); return; }
    vec3 premul = clamp(B - C * (1.0 - a), vec3(0.0), vec3(1.0));
    // XeSSSynthDebugTint: paint every UI pixel magenta (premultiplied). In UI mode 3 the wheel
    // turning magenta on GENERATED frames is conclusive proof the SDK composites OUR texture;
    // if the wheel keeps its normal colors there, the tagged texture is being ignored upstream.
    if (params.debugTint != 0) premul = vec3(1.0, 0.0, 1.0) * premul.g;
    vec4 color = vec4(premul, a);
    // Staging is R8G8B8A8_UNORM; when the target payload is BGRA the component byte order
    // is pre-swizzled so the format-compatible raw copy lands semantically correct.
    if (params.swizzleBGRA != 0) color = color.bgra;
    imageStore(uiColor, p, color);
}
